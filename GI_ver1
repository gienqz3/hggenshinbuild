    function renderTeams() {
      const container = document.getElementById('content');
      container.innerHTML = teamData.map(team => `
        <div id="team-${team.id}" class="team-container ${team.id === 1 ? 'active' : ''}">
          <div class="team-desc">${team.desc}</div>
          <div class="character-grid">
            ${team.members.map(m => `
              <div class="char-card">
                <div class="char-header">
                  <div class="char-name">
                    <span>${m.name}</span>
                    <span class="char-level">${m.level}</span>
                  </div>
                  <div class="char-role">${m.role}</div>
                </div>
                <div>
                  <div class="section-title">Vũ khí đề xuất</div>
                  <div class="info-content highlight">${m.weapon}</div>
                </div>
                <div>
                  <div class="section-title">Thánh di vật</div>
                  <div class="info-content">${m.artifact}</div>
                </div>
                <div>
                  <div class="section-title">Dòng chính</div>
                  <div class="info-content">${m.stats}</div>
                </div>
                <div>
                  <div class="section-title">Dòng phụ ưu tiên</div>
                  <div class="info-content">${m.subStats}</div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function switchTeam(teamId) {
      document.querySelectorAll('.tab-btn').forEach((btn, idx) => {
        btn.classList.toggle('active', idx + 1 === teamId);
      });
      document.querySelectorAll('.team-container').forEach(c => {
        c.classList.remove('active');
      });
      document.getElementById(`team-${teamId}`).classList.add('active');
    }

    renderTeams();
  </script>
</body>
</html>
